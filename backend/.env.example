# ===== Style AI 后端环境变量 =====

# 管理员密码（首次启动自动创建 admin 账号）
ADMIN_PASSWORD=your_password_here

# Flask/Express 通用密钥（Token 签名用）
SECRET_KEY=your_secret_key_at_least_16_chars

# 端口（与 Python 版保持一致）
PORT=5000

# CORS 允许的来源（逗号分隔，生产环境必须配置）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DashScope API（面容分析、虚拟试穿）
DASHSCOPE_API_KEY=

# LLM API（星座运势等创意文案生成）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-turbo

# 虚拟试穿 API
TRYON_API_URL=
TRYON_API_KEY=
TRYON_MODEL=

# 顾客临时数据过期时间（秒），默认 2 小时
CUSTOMER_DATA_TTL=7200

# ===== 微信支付 APIv3（Native 收款）=====
# 任一项留空 = 在线收款不通电，前端自动回落到"静态收款码 + 上传付款凭证"。
# 两个 *_KEY_PATH 按容器内写法填（backend/.env 挂到 /app/.env、certs 挂到 /app/certs）；
# 若绕过 Docker 直接 node server.js，改成 pem 文件的绝对路径。
WXPAY_MCHID=
WXPAY_SERIAL_NO=
# 商户平台「API安全」里自己设的 32 位字符串，设置后平台不再回显
WXPAY_APIV3_KEY=
# 「API安全 - 微信支付公钥」页面的"微信支付公钥ID"，形如 PUB_KEY_ID_xxx
WXPAY_PUBLIC_KEY_ID=
WXPAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WXPAY_PUBLIC_KEY_PATH=/app/certs/pub_key.pem
# 必须是 https 且能被反代直达后端，不能落到 SPA 兜底
WXPAY_NOTIFY_URL=https://style.sparklove.cn/api/payment/notify
# 必填。真单实测：不带 appid 下单回 400「输入源"/body/appid"映射到字段"公众号ID"必填性规则校验失败」；
# 带一个没关联过的 appid 回 400「商户号mch_id与appid不匹配」。
# 须是在商户平台「产品中心 - AppID账号管理」里与本商户号关联成功的公众号/小程序/网站应用 AppID。
WXPAY_APPID=

# ===== 支付宝 电脑网站支付（alipay.trade.page.pay）=====
# 任一项留空 = 在线收款不通电，前端自动回落到"静态收款码 + 上传付款凭证"。
# 两个 *_KEY_PATH 按容器内写法填（compose 把 certs/wxpay 挂到 /app/certs、certs/alipay 挂到 /app/certs-alipay）；
# 若绕过 Docker 直接 node server.js，改成 pem 文件的绝对路径。
# 开放平台「控制台 - 我的应用 - 应用信息」里的 AppID，16 位数字
ALIPAY_APP_ID=
# 自己生成 RSA2 密钥对后，把"应用公钥"贴进开放平台「设置公钥」；私钥只留在服务器上
ALIPAY_PRIVATE_KEY_PATH=/app/certs-alipay/apPrivateKey.pem
# ⚠️ 这把是「支付宝公钥」——核身通过后平台返回给你、用来验支付宝发来的数据，
# 与上面那把应用密钥对里的公钥不是同一个东西，贴错会全程验签失败
ALIPAY_PUBLIC_KEY_PATH=/app/certs-alipay/alipayPublicKey.pem
# 必须是 https 且能被反代直达后端，不能落到 SPA 兜底
ALIPAY_NOTIFY_URL=https://style.sparklove.cn/api/payment/notify/alipay
# 可选：付款后浏览器同步跳回的前端地址（只影响体验，到账仍以异步通知为准）
ALIPAY_RETURN_URL=
# 可选：商户号 PID（2088 开头）。填了会用它卡住通知里的 seller_id，防止别人拿自己
# 的收款单来顶我们的订单号
ALIPAY_SELLER_ID=

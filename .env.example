# Copy this file to .env. The server refuses to start in production until both
# public demo values below are replaced. They are placeholders, not credentials.
NODE_ENV=production
SECRET_KEY=demo-only-replace-before-any-deployment-32-chars
ADMIN_PASSWORD=demo-only-replace-before-any-deployment

HOST=0.0.0.0
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI services. Empty values keep external calls disabled.
DASHSCOPE_API_KEY=

# Public origin reachable by the external try-on provider (for example https://style.example.com).
# Must be an HTTP(S) origin only: no path, credentials, query string, or fragment.
# Production requires HTTPS. Missing/invalid values make direct try-on return 503 without
# submitting images, writing files, or degrading to the original photo. Never use a request Host here.
PUBLIC_BASE_URL=

# Reserved for future LLM creative copy; the current backend does not read these.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Optional payment credentials. Empty values keep online payment disabled.
WXPAY_MCHID=
WXPAY_SERIAL_NO=
WXPAY_APIV3_KEY=
WXPAY_PUBLIC_KEY_ID=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_PUBLIC_KEY_PATH=
WXPAY_NOTIFY_URL=
WXPAY_APPID=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_SELLER_ID=

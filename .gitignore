backend/uploads/

# 维护脚本产物
backend/scripts/scan-report.json

# 日志
*.log
backend/logs/

# 模型文件(体积大,不纳入 git,本地存放即可；仅放行项目自产 CC0 演示资产)
models/*
!models/.gitkeep
!models/demo/
models/demo/*
!models/demo/PortfolioBot.pmx
!models/demo/LICENSE.md

